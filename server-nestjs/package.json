{
  "name": "project-management",
  "version": "0.0.1",
  "description": "Project Management System API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "start:app-api": "nest start app-api --watch",
    "start:app-api:dev": "nest start app-api --watch",
    "start:app-api:debug": "nest start app-api --debug --watch",
    "start:app-api:prod": "node dist/apps/app-api/src/main.js",
    "build:app-api": "nest build app-api",
    "start:cronjob-worker": "nest start cronjob-worker --watch",
    "start:cronjob-worker:dev": "nest start cronjob-worker --watch",
    "start:cronjob-worker:prod": "node dist/apps/cronjob-worker/src/main.js",
    "build:cronjob-worker": "nest build cronjob-worker",
    "start:notification": "nest start notification --watch",
    "start:notification:dev": "nest start notification --watch",
    "start:notification:prod": "node dist/apps/notification/src/main.js",
    "build:notification": "nest build notification",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate libs/entity/src/migrations/Init -d libs/entity/src/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d libs/entity/src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d libs/entity/src/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.954.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.3.3",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}

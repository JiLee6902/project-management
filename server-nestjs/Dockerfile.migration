# Dockerfile for running migrations separately in CI/CD
# Usage: docker build -f Dockerfile.migration -t pm-migration .
#        docker run --env-file .env.production pm-migration

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build only the entity library (contains migrations and data-source)
RUN npm run build:app-api

# Production stage
FROM node:20-alpine AS migration

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install only production dependencies + pg for health check
RUN npm ci --legacy-peer-deps --omit=dev && \
    npm cache clean --force

# Copy built files
COPY --from=builder /app/dist ./dist

# Copy migration script
COPY migrate.sh ./
RUN chmod +x migrate.sh

# Set environment
ENV NODE_ENV=production

# Run migrations
CMD ["./migrate.sh"]
